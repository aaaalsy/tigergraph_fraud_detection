# TigerGraph Cloud Savanna / Community Edition Configuration
# To use Live TigerGraph, set TG_MODE=live and provide your credentials.
# Otherwise, TG_MODE=embedded will run the high-fidelity local graph engine out-of-the-box.
TG_MODE=embedded
TG_HOST=https://your-domain.i.tgcloud.io
TG_GRAPH=FraudInvestigationGraph
TG_SECRET=your_tigergraph_secret_key
TG_TOKEN=your_tigergraph_api_token
TG_USERNAME=tigergraph
TG_PASSWORD=tigergraph

# Port and Server Configuration
PORT=5001
HOST=127.0.0.1
DEBUG=True

# GraphRAG & LLM Configuration (Optional external LLM grounding)
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
